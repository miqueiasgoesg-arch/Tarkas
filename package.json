{
  "name": "projeto-tarkas",
  "productName": "Tarkas",
  "version": "0.2.3",
  "description": "Companion de progressao para Escape from Tarkov",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js",
    "build:win": "npm run build:portable && npm run build:installer",
    "dist": "npm run check && npm run build:win",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "private": true,
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.tarkas.app",
    "productName": "Tarkas",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "calibration-config.json",
      "map-config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "assets/tarkas-icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Tarkas-Portable-${version}-Windows.${ext}"
    },
    "nsis": {
      "artifactName": "Tarkas-Setup-${version}-Windows.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tarkas",
      "deleteAppDataOnUninstall": false
    }
  }
}
